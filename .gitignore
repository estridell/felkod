# BMW Standard Tools files from the cable kit: proprietary, ~1.4 GB. Kept locally, never committed.
# See vendor/README.md for what lives there and how to repopulate it.
vendor/bmw/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# .NET
bin/
obj/

# felkod session data
sessions/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Spike traces (raw EDIABAS/IFH logs)
spike/traces/

# Developer tools: a separate (private) git repo checked out here
devtools/

# Community definitions without a published licence (fetched by a dev script)
vendor/community/

# DME flash reads (MS4x Flasher .bin files)
firmware/

# Local audit scratch files
work/
