#!/usr/bin/env python3
"""felkod: diagnostics for a BMW E46 (Siemens MS43) over a K+DCAN cable.

Talks to felkodd (the daemon that owns the cable) over a unix socket and starts it when needed.
Commands print one JSON object: {"ok": true, "data": ..., "warnings": [...]} or
{"ok": false, "error": {"code": ..., "message": ...}}. Exit status 0 = ok, 1 = error, 2 = usage.
Help and usage errors are plain text. Stdlib only.
"""

import argparse
import json
import math
import os
import pwd
import socket
import sqlite3
import subprocess
import sys
import time
from contextlib import closing
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DAEMON = Path(os.environ.get("FELKOD_DAEMON", REPO / "daemon" / "bin" / "Release" / "net10.0" / "felkodd"))
CALL_TIMEOUT_S = 90  # a job can wait for one logging step, then take up to the daemon's job timeout


class Failure(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def socket_path():
    if os.environ.get("FELKOD_SOCKET"):
        return Path(os.environ["FELKOD_SOCKET"])
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "felkod.sock"
    # felkodd's own default: .NET's temp directory and the passwd user name
    try:
        user = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:  # no passwd entry, e.g. a container run with --user 1234
        user = os.environ.get("USER", "user")
    return Path(os.environ.get("TMPDIR") or "/tmp") / f"felkod-{user}.sock"


def data_dir():
    base = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share"
    return Path(base) / "felkod"


def daemon_running():
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(str(socket_path()))
        return True
    except OSError:
        return False


def start_daemon(extra_args=()):
    """Starts felkodd unless one is running; returns the pid of the one it started, or None."""
    if daemon_running():
        return None
    if not DAEMON.exists():
        raise Failure("daemon_missing", f"{DAEMON} not found; build it with: dotnet build -c Release {REPO / 'daemon'}")
    extra_args = list(extra_args)
    # FELKOD_PORT keeps auto-started daemons on a test port (e.g. a fake ECU on a pty)
    if os.environ.get("FELKOD_PORT") and "--port" not in extra_args:
        extra_args += ["--port", os.environ["FELKOD_PORT"]]
    data_dir().mkdir(parents=True, exist_ok=True)
    with open(data_dir() / "felkodd.log", "ab") as log:
        process = subprocess.Popen([str(DAEMON), "--socket", str(socket_path()), *extra_args], stdin=subprocess.DEVNULL,
                                   stdout=log, stderr=log, start_new_session=True)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if daemon_running():
            return process.pid
        if process.poll() is not None:
            # it also exits when it loses a start race to a felkodd started by a parallel felkod call,
            # which listens moments later; only if none does is this a failed start
            deadline = min(deadline, time.monotonic() + 2)
        time.sleep(0.1)
    raise Failure("daemon_start_failed", f"felkodd did not come up; see {data_dir() / 'felkodd.log'}")


def call(method, params=None, autostart=True):
    """Sends one request; returns the daemon's response object (ok/data/warnings or ok/error)."""
    if autostart:
        start_daemon()
    request = json.dumps({"id": 1, "method": method, "params": params or {}}) + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            deadline = time.monotonic() + CALL_TIMEOUT_S
            s.settimeout(CALL_TIMEOUT_S)
            s.connect(str(socket_path()))
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise socket.timeout()
            s.settimeout(remaining)
            s.sendall(request.encode())
            buffer = b""
            while b"\n" not in buffer:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise socket.timeout()
                s.settimeout(remaining)
                chunk = s.recv(65536)
                if not chunk:
                    raise Failure("daemon_gone", "felkodd closed the connection")
                buffer += chunk
    except socket.timeout:
        raise Failure("daemon_timeout", f"no answer from felkodd within {CALL_TIMEOUT_S} s")
    except (ConnectionResetError, BrokenPipeError):
        raise Failure("daemon_gone", "felkodd closed the connection")
    except (FileNotFoundError, ConnectionRefusedError):
        raise Failure("daemon_not_running", "felkodd is not running; start it with: felkod daemon start")
    try:
        response = json_loads(buffer.split(b"\n", 1)[0])
    except ValueError as error:
        raise Failure("daemon_protocol", f"invalid response from felkodd: {error}") from error
    problem = response_problem(response)
    if problem:
        raise Failure("daemon_protocol", f"invalid response from felkodd: {problem}")
    response.pop("id", None)
    return response


def response_problem(response):
    """What is wrong with a decoded daemon response, or None if it has the documented shape."""
    if not isinstance(response, dict):
        return "not a JSON object"
    if not isinstance(response.get("ok"), bool):
        return "ok must be true or false"
    warnings = response.get("warnings", [])
    if not isinstance(warnings, list) or not all(isinstance(warning, str) for warning in warnings):
        return "warnings must be a list of strings"
    if response["ok"]:
        return None if "data" in response else "ok response without data"
    error = response.get("error")
    if not isinstance(error, dict) or not all(isinstance(error.get(key), str) for key in ("code", "message")):
        return "error response without a code and message"
    return None


def json_loads(value):
    """Decode JSON without accepting Python's NaN/Infinity extensions or overflowing floats."""
    def number(text):
        value = float(text)
        if not math.isfinite(value):
            raise ValueError(f"non-finite JSON number: {text}")
        return value

    return json.loads(value, parse_float=number, parse_constant=number)


def data(method, params=None, *, autostart=True):
    """Calls the daemon and returns its data, raising Failure on an error response."""
    response = call(method, params, autostart=autostart)
    if not response["ok"]:
        raise Failure(response["error"]["code"], response["error"]["message"])
    WARNINGS.extend(response.get("warnings", []))
    return response["data"]


WARNINGS = []
NATIVE_HELP = ("felkodd's own DS2 transport for jobs that send one telegram, decoded by the SGBD; "
               "the raw telegrams are stored in the session's raw table")
GAP_HELP = "native: ms between a reply and the next request (default 100, BMW's regeneration time for MS43)"
SESSION_TABLES = ("samples(id, t, elapsed_s, cycle, job, ms); readings(sample_id, set_index, name, value, text, unit); "
                  "events(id, t, elapsed_s, kind, job, detail); meta(key, value); "
                  "raw(sample_id, request, response, echo_ms, first_byte_ms, total_ms, waited_ms, retries) for native samples; "
                  "view series(t, elapsed_s, job, set_index, name, value, text, unit). t is UTC ISO 8601 when the request "
                  "was sent (native) or the job started (EdiabasLib, which first waits the SGBD's regeneration time, "
                  "100 ms for MS43); "
                  "names are the SGBD's result names; events.kind is link_lost, still_down, link_restored, job_error, "
                  "not_native, internal_error or paused; meta values are JSON text")


def jobs_arg(text):
    return [job.strip() for job in text.split(",") if job.strip()] if text else []


def positive_int(text):
    value = int(text)
    if value < 1:
        raise argparse.ArgumentTypeError(f"must be >= 1: {text}")
    return value


def seconds(text):
    value = float(text)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"must be a number of seconds >= 0: {text}")
    return value


def positive_seconds(text):
    value = seconds(text)
    if value == 0:
        raise argparse.ArgumentTypeError(f"must be > 0 seconds: {text}")
    return value


# --- commands -------------------------------------------------------------------------------

def cmd_status(args):
    if not daemon_running():
        return {"daemon": {"running": False, "socket": str(socket_path())},
                "port": {"path": "/dev/felkod-kline", "present": os.path.exists("/dev/felkod-kline")}}
    status = data("status", autostart=False)
    status["daemon"]["running"] = True
    return status


def cmd_daemon(args):
    if args.action == "start":
        extra = []
        for flag in ("port", "sgbd", "ecu_path", "job_timeout"):
            if getattr(args, flag):
                extra += [f"--{flag.replace('_', '-')}", str(getattr(args, flag))]
        pid = start_daemon(extra)
        status = data("status")
        # the one running can be another felkod call's, which won a start race against ours
        started = pid is not None and status["daemon"]["pid"] == pid
        result = {"started": started, "already_running": not started, "socket": str(socket_path())}
        if not started:
            port = status["port"]["path"]
            result["port"] = port
            if args.port and args.port != port:
                WARNINGS.append(f"felkodd is already running on {port}; --port {args.port} was not applied "
                                "(daemon stop first)")
        return result
    if args.action == "stop":
        if not daemon_running():
            return {"stopped": False, "already_stopped": True}
        pid = data("status", autostart=False)["daemon"]["pid"]
        try:
            data("daemon.stop", autostart=False)
        except Failure as failure:
            if failure.code != "daemon_gone":  # it may close the socket before the reply is out
                raise
        # done only when the process has exited: it finishes a running session on the way out
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return {"stopped": True, "pid": pid}
            except PermissionError:  # another user's process with that pid: ours is gone
                return {"stopped": True, "pid": pid}
            time.sleep(0.1)
        raise Failure("daemon_stop_failed", f"felkodd (pid {pid}) is still running after 30 s")
    raise Failure("bad_request", f"unknown daemon action {args.action}")


def cmd_ident(args):
    return data("ident")


def cmd_faults(args):
    if args.action == "clear":
        return data("faults.clear", {"confirm": args.confirm})
    return data("faults.read")


def cmd_jobs(args):
    if args.job:
        return data("jobs.describe", {"job": args.job})
    return data("jobs.list")


def cmd_run(args):
    return data("job.run", {"job": args.job, "args": args.args or "", "allow_write": args.allow_write})


def native_params(args):
    params = {"native": args.native}
    if args.gap_ms is not None:
        params["gap_ms"] = args.gap_ms
    return params


def cmd_read(args):
    if args.duration is None:
        return {"results": [data("job.run", {"job": job, **native_params(args)}) for job in args.jobs]}
    started = data("log.start", {"jobs": args.jobs, "slow_jobs": jobs_arg(args.slow_jobs),
                                 "slow_every": args.slow_every, "duration_s": args.duration, "note": args.note,
                                 **native_params(args)})
    session_id = started["session_id"]
    while (status := data("log.status", autostart=False)).get("session_id") == session_id:
        # Poll even for a long duration: another CLI can stop the session, and passing an
        # arbitrarily large finite --duration straight to sleep overflows on some platforms.
        time.sleep(min(args.duration, 0.2))
    return session_show(session_id)


def cmd_log(args):
    if args.action == "start":
        if not args.jobs:
            raise Failure("bad_request", "log start needs --jobs")
        return data("log.start", {"jobs": jobs_arg(args.jobs), "slow_jobs": jobs_arg(args.slow_jobs),
                                  "slow_every": args.slow_every, "duration_s": args.duration or 0, "note": args.note,
                                  **native_params(args)})
    if args.action == "stop":
        return data("log.stop")
    return data("log.status")


def cmd_bench(args):
    return data("bench", {"job": args.job, "n": args.n, **native_params(args)})


def cmd_ds2(args):
    if args.action == "request":
        return data("ds2.request", {"job": args.value, "args": args.args or ""})
    if args.action == "decode":
        if not args.response:
            raise Failure("bad_request", "ds2 decode needs --response HEX")
        return data("ds2.decode", {"job": args.value, "args": args.args or "", "response": args.response})
    params = {"request": args.value, "allow_write": args.allow_write}
    if args.gap_ms is not None:
        params["gap_ms"] = args.gap_ms
    return data("ds2.raw", params)


def cmd_sessions(args):
    # read from disk, so listing never needs (or starts) the daemon
    root = data_dir() / "sessions"
    running = None
    if daemon_running():
        try:
            status = data("log.status", autostart=False)
            if not isinstance(status, dict):
                raise Failure("daemon_protocol", "invalid log.status data from felkodd: not a JSON object")
            running = status.get("session_id")
        except (Failure, OSError) as error:
            WARNINGS.append(f"could not check the running session: {error}")
    sessions = []
    for meta_path in sorted(root.glob("*/meta.json"), reverse=True):
        try:
            meta = json_loads(meta_path.read_text())
        except (OSError, UnicodeError, ValueError):
            continue
        if not isinstance(meta, dict):
            continue
        meta["dir"] = str(meta_path.parent)
        meta["running"] = running is not None and meta.get("id") == running
        sessions.append(meta)
    return {"sessions_dir": str(root), "sessions": sessions}


def session_db(session_id):
    path = data_dir() / "sessions" / session_id / "session.sqlite"
    if not path.exists():
        raise Failure("unknown_session", f"no session {session_id} in {path.parent.parent}")
    # percent-encoded, so '?', '#' or '%' in the path are not read as URI syntax
    db = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True)
    db.row_factory = sqlite3.Row
    # mode=ro covers the session database only: ATTACH and VACUUM INTO could still create other files
    allowed = {sqlite3.SQLITE_SELECT, sqlite3.SQLITE_READ, sqlite3.SQLITE_FUNCTION, sqlite3.SQLITE_RECURSIVE}
    db.set_authorizer(lambda action, *_: sqlite3.SQLITE_OK if action in allowed else sqlite3.SQLITE_DENY)
    return db


def session_show(session_id):
    with closing(session_db(session_id)) as db:
        meta = {}
        for row in db.execute("SELECT key, value FROM meta"):
            try:  # non-string values are stored as JSON text
                meta[row["key"]] = json_loads(row["value"]) if row["value"] is not None else None
            except ValueError:
                meta[row["key"]] = row["value"]
        span = db.execute("SELECT MIN(t) AS first, MAX(t) AS last, COUNT(*) AS samples FROM samples").fetchone()
        jobs = {row["job"]: {"samples": row["n"], "mean_ms": round(row["ms"], 1)} for row in db.execute(
            "SELECT job, COUNT(*) AS n, AVG(ms) AS ms FROM samples GROUP BY job")}
        names = [dict(row) for row in db.execute(
            "SELECT s.job, r.name, r.unit, COUNT(*) AS n, MIN(r.value) AS min, MAX(r.value) AS max "
            "FROM readings r JOIN samples s ON s.id = r.sample_id GROUP BY s.job, r.name ORDER BY s.job, r.name")]
        events = [dict(row) for row in db.execute("SELECT t, elapsed_s, kind, job, detail FROM events ORDER BY id")]
        return {"session_id": session_id, "meta": meta, "first_sample": span["first"], "last_sample": span["last"],
                "samples": span["samples"], "jobs": jobs, "readings": names, "events": events,
                "tables": SESSION_TABLES}


def cmd_session(args):
    if args.action == "show":
        return session_show(args.id)
    with closing(session_db(args.id)) as db:
        cursor = db.execute(args.sql)
        columns = [d[0] for d in cursor.description or []]
        rows = cursor.fetchmany(args.limit + 1)
    if len(rows) > args.limit:
        WARNINGS.append(f"truncated to {args.limit} rows; raise --limit or aggregate in SQL")
        rows = rows[:args.limit]
    for row in rows:
        for value in row:
            if isinstance(value, bytes):
                raise Failure("sql", "query returned a BLOB; use hex(column) or CAST(column AS TEXT) for JSON output")
            if isinstance(value, float) and not math.isfinite(value):
                raise Failure("sql", "query returned a non-finite number, which JSON cannot represent")
    return {"columns": columns, "rows": [list(row) for row in rows], "row_count": len(rows)}


# --- parser ---------------------------------------------------------------------------------

def build_parser():
    parser = argparse.ArgumentParser(prog="felkod", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="daemon, cable and link state; does not start the daemon").set_defaults(func=cmd_status)

    p = sub.add_parser("daemon", help="start or stop felkodd")
    p.add_argument("action", choices=["start", "stop"])
    p.add_argument("--port", help="serial device (default /dev/felkod-kline)")
    p.add_argument("--sgbd", help="SGBD to use (default ms430ds0)")
    p.add_argument("--ecu-path", help="directory with the SGBD files (default vendor/bmw/ediabas/ecu)")
    p.add_argument("--job-timeout", type=positive_seconds, help="seconds before a job counts as failed (default 15)")
    p.set_defaults(func=cmd_daemon)

    sub.add_parser("ident", help="DME identification (IDENT job)").set_defaults(func=cmd_ident)

    p = sub.add_parser("faults", help="read stored faults (FS_LESEN), or clear them (FS_LOESCHEN)")
    p.add_argument("action", nargs="?", choices=["read", "clear"], default="read")
    p.add_argument("--confirm", action="store_true",
                   help="required for clear; the faults are saved to the audit log before clearing")
    p.set_defaults(func=cmd_faults)

    p = sub.add_parser("jobs", help="list the SGBD's jobs, or describe one (arguments, results, comments)")
    p.add_argument("job", nargs="?")
    p.set_defaults(func=cmd_jobs)

    p = sub.add_parser("run", help="run one SGBD job; jobs that change the car need --allow-write; the "
                                   "metadata jobs _JOBS, _JOBCOMMENTS, _ARGUMENTS, _RESULTS, _VERSIONINFO, "
                                   "_TABLES and _TABLE <name> read the SGBD offline")
    p.add_argument("job")
    p.add_argument("args", nargs="?", help="EDIABAS argument string, e.g. 'arg1;arg2'")
    p.add_argument("--allow-write", action="store_true")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("read", help="run read-only jobs once, or log them for --duration seconds")
    p.add_argument("jobs", nargs="+")
    p.add_argument("--duration", type=positive_seconds)
    p.add_argument("--slow-jobs", help="comma list, run every --slow-every cycles")
    p.add_argument("--slow-every", type=positive_int, default=10)
    p.add_argument("--note")
    p.add_argument("--native", action="store_true", help=NATIVE_HELP)
    p.add_argument("--gap-ms", type=int, help=GAP_HELP)
    p.set_defaults(func=cmd_read)

    p = sub.add_parser("log", help="background logging session: start, stop, status")
    p.add_argument("action", choices=["start", "stop", "status"])
    p.add_argument("--jobs", help="comma list of read-only jobs, run every cycle")
    p.add_argument("--slow-jobs", help="comma list, run every --slow-every cycles")
    p.add_argument("--slow-every", type=positive_int, default=10)
    p.add_argument("--duration", type=seconds, help="seconds; default runs until log stop")
    p.add_argument("--note")
    p.add_argument("--native", action="store_true", help=NATIVE_HELP)
    p.add_argument("--gap-ms", type=int, help=GAP_HELP)
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("bench", help="time a read-only job; --native also reports the ECU's reply latency")
    p.add_argument("job")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--native", action="store_true", help=NATIVE_HELP)
    p.add_argument("--gap-ms", type=int, help=GAP_HELP)
    p.set_defaults(func=cmd_bench)

    p = sub.add_parser("ds2", help="DS2 telegrams: request (what a job sends), decode (a reply via the SGBD), "
                                   "raw (send one telegram)")
    p.add_argument("action", choices=["request", "decode", "raw"])
    p.add_argument("value", help="job name (request, decode) or telegram hex (raw; checksum optional)")
    p.add_argument("--args", help="EDIABAS argument string for the job")
    p.add_argument("--response", help="reply hex for decode, as stored in a session's raw table")
    p.add_argument("--gap-ms", type=int, help=GAP_HELP)
    p.add_argument("--allow-write", action="store_true",
                   help="raw: send a telegram that no read-only SGBD job sends")
    p.set_defaults(func=cmd_ds2)

    sub.add_parser("sessions", help="list logging sessions").set_defaults(func=cmd_sessions)

    p = sub.add_parser("session", help="inspect a session: show (summary) or query (read-only SQL)",
                       description="Queries are SELECT or WITH only (no PRAGMA, ATTACH or writes). "
                                   "Session database (SQLite, read-only here): " + SESSION_TABLES)
    p.add_argument("action", choices=["show", "query"])
    p.add_argument("id")
    p.add_argument("sql", nargs="?")
    p.add_argument("--limit", type=positive_int, default=1000)
    p.set_defaults(func=cmd_session)
    return parser


def main():
    args = build_parser().parse_args()
    if getattr(args, "action", None) == "query" and not args.sql:
        build_parser().error("session query needs SQL")
    try:
        output = {"ok": True, "data": args.func(args), "warnings": WARNINGS}
        code = 0
    except Failure as failure:
        output = {"ok": False, "error": {"code": failure.code, "message": failure.message}, "warnings": WARNINGS}
        code = 1
    except sqlite3.Error as error:
        output = {"ok": False, "error": {"code": "sql", "message": str(error)}, "warnings": WARNINGS}
        code = 1
    except OSError as error:  # e.g. the data directory or felkodd.log cannot be created
        output = {"ok": False, "error": {"code": "io", "message": str(error)}, "warnings": WARNINGS}
        code = 1
    print(json.dumps(output, indent=2 if sys.stdout.isatty() else None, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main())
