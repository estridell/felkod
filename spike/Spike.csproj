<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 0 spike: compiles EdiabasLib's sources directly, since upstream only targets Windows and Android. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>felkod-spike</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS8767;CS8622;CS0618;CA1416;SYSLIB0014;SYSLIB0021;SYSLIB0051</NoWarn>
    <EdiabasLibDir>$(MSBuildThisFileDirectory)../vendor/ediabaslib/EdiabasLib/EdiabasLib/</EdiabasLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(EdiabasLibDir)*.cs" Exclude="$(EdiabasLibDir)*Android.cs;$(EdiabasLibDir)BtLeGattSpp.cs" Link="EdiabasLib/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
  </ItemGroup>
</Project>
